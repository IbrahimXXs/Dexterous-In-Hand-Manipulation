# Not part of this repository (Class 07 packages and other course material, kept locally)
etc/

# Python environments and caches
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Run outputs
outputs/
training_source/project/logs/
training_source/project/videos/

# OS
.DS_Store

# MuJoCo runtime log
MUJOCO_LOG.TXT

# Estimator datasets and experiment outputs (large)
training_source/project/data/
training_source/project/experiments/scratch_state_estimation/data/
training_source/project/experiments/force_estimation/data/
training_source/project/experiments/force_estimation/runs/*/last.pt
