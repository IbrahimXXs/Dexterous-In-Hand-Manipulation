# LEAP deploy kit: per-machine install state (recreated by ./install.sh)
LEAP_Hand_RL_Deploy_Kit/.python
LEAP_Hand_RL_Deploy_Kit/.venv/
LEAP_Hand_RL_Deploy_Kit/kit/_deps/
# shadow-run unlock markers are per-station; a new station must redo its shadow runs
LEAP_Hand_RL_Deploy_Kit/logs/.shadow_passed_*

# C5-HW-V1 simulation rollouts (~200 MB, regenerate with
