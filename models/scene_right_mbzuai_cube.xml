<mujoco model="right leap hand continuous yaw scene">
  <compiler angle="radian" meshdir="./assets/"/>
  <!-- Same as right_hand.xml: <attach> keeps only the parent's <option>. -->
  <option integrator="implicitfast" cone="elliptic" impratio="100"/>

  <statistic center="-0.02 0.02 0.12" extent="0.32"/>

  <visual>
    <headlight diffuse="0.75 0.75 0.75" ambient="0.35 0.35 0.35" specular="0.15 0.15 0.15"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="135" elevation="-25"/>
  </visual>

  <asset>
    <model name="leap_right_hand" file="right_hand.xml"/>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <texture type="2d" name="mbzuai_cube_tex" file="assets/mbzuai_cube.png"/>
    <material name="mbzuai_cube_mat" texture="mbzuai_cube_tex" rgba="1 1 1 1"/>
    <!-- meshdir="assets" (compiler above) resolves this mesh. -->
    <mesh name="mbzuai_cube_mesh" file="dex_cube.obj" scale="0.029 0.029 0.029"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane" pos="0 0 -0.15"/>
    <!-- MJLab mounts the hand on a fixed base at init_state pos (0, 0, 0.1); with the palm's
         own 0.1 m offset the palm sits at z = 0.2 m. Without this base the hand renders
         10 cm below the recorded cube poses and the cube appears to float above it. -->
    <body name="mocap_base" pos="0 0 0.1">
      <attach model="leap_right_hand" body="palm" prefix=""/>
    </body>
    <body name="cube" pos="-0.01 0.035 0.29">
      <freejoint name="cube_joint"/>
      <geom name="cube_geom" type="box" size="0.029 0.029 0.029" rgba="0 0 0 0" mass="0.085"/>
      <geom name="cube_visual" type="mesh" mesh="mbzuai_cube_mesh" material="mbzuai_cube_mat" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
</mujoco>

