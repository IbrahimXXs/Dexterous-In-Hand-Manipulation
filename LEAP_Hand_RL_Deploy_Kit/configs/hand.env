# LEAP Hand RL Deploy Kit - station settings (sourced by leap.sh).
# Edit these once for your hand; command-line flags after "--" override them.

# Serial device. "auto" = first /dev/serial/by-id/* entry, else /dev/ttyUSB0.
LEAP_PORT=auto
LEAP_BAUD=4000000

# Hardware PID profile: H1 (P=600, D=150) or H2 (P=800, D=150).
# Use the one your policy was trained/identified with.
LEAP_GAIN_PROFILE=H1

# Run lengths in policy steps (20 Hz -> 600 = 30 s, 120 = 6 s).
SHADOW_STEPS=${SHADOW_STEPS:-600}
RUN_STEPS=${RUN_STEPS:-600}   # 30 s (the study's trial length); 0 = until Ctrl+C

# Seconds to place/centre the object before motion; ramp to grasp; ramp home.
START_DELAY_S=5
INIT_DURATION_S=5
RETURN_HOME_S=3

# Safety guards (the bridge aborts and disables torque when exceeded).
CURRENT_LIMIT_MA=350
CURRENT_ABORT_MA=450
TEMPERATURE_ABORT_C=60
VELOCITY_ABORT_RAD_S=8.0
TRACKING_ERROR_ABORT_RAD=0.65
MAX_COMMAND_STEP_RAD=0.05

# Live viewer (./leap.sh live ...): a Python with mujoco. "auto" = the repo's
# .venv (uv sync at the repo root), else "uv run python" from the repo root.
LEAP_VIEWER_PYTHON=${LEAP_VIEWER_PYTHON:-auto}
LEAP_LIVE_UDP=${LEAP_LIVE_UDP:-127.0.0.1:47800}

# Real-hand policy comparison (./leap.sh trial ...): A3, C5, R1, P0
TRIAL_STEPS=${TRIAL_STEPS:-1200}   # 60 s per trial (speed and retention from the same run)
TRIAL_BLOCKS=${TRIAL_BLOCKS:-5}    # 5 blocks x 4 policies = 20 trials

# Camera dashboard (./leap.sh vision): listens here and relays to the kit viewer (LEAP_LIVE_UDP).
# In the terminal that runs the hand, `export LEAP_USE_VISION=1` sends the telemetry here instead.
LEAP_VISION_UDP=${LEAP_VISION_UDP:-127.0.0.1:47810}
# Cube layout: the MEASURED layout (the physical cube does not follow assets/mbzuai_cube/layout.json;
# confirmed on 25 Nov on ALL six faces by two independent recordings; per-face marker offsets fitted the same day -
# docs/realsense_setup_2026-11-25.md sections 3b and 3d).
# --no-twin: the kit viewer already shows the hand; the dashboard twin adds nothing until camera->palm is calibrated.
LEAP_VISION_LAYOUT_DIR=training_source/project/assets/mbzuai_cube/measured
LEAP_VISION_LAYOUT_ARGS=${LEAP_VISION_LAYOUT_ARGS:---layout $LEAP_VISION_LAYOUT_DIR/layout.measured_rgb.json --print-layout $LEAP_VISION_LAYOUT_DIR/marker_print_layout.measured_perface_20261125.json}
# Markers are only searched in the hand region (x >= 400 px of 1280; a second cube on the table at the
# left is then never tracked) and poses beyond 0.7 m / behind the camera are dropped.  Re-measure the
# region if the camera is moved (the hand cube was at x 600-960 px on 25 Nov).
LEAP_VISION_GUARD_ARGS=${LEAP_VISION_GUARD_ARGS:---roi 400,0,1280,720 --max-range-m 0.7}
# --display-hz 10: the panel is redrawn 10x/s, tracking + recording run at the full camera rate
LEAP_VISION_ARGS=${LEAP_VISION_ARGS:---camera realsense --width 1280 --height 720 --fps 30 --no-twin --display-hz 10 $LEAP_VISION_LAYOUT_ARGS $LEAP_VISION_GUARD_ARGS}
# Per-trial camera (./leap.sh trial with LEAP_USE_VISION=1): the trial whose cube turned the trained
# (counter-clockwise) way fixes the sign of the camera rotation; render a dashboard.mp4 per trial (1/0).
LEAP_VISION_SIGN_TRIAL=${LEAP_VISION_SIGN_TRIAL:-1}
LEAP_VISION_DASHBOARD_VIDEO=${LEAP_VISION_DASHBOARD_VIDEO:-1}
